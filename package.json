{
  "name": "deepwrite",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @deepwrite/desktop dev",
    "electron:ensure": "node tools/ensure-electron-runtime.mjs",
    "build": "pnpm --filter @deepwrite/desktop build",
    "typecheck": "vue-tsc --noEmit -p apps/desktop/tsconfig.web.json && tsc --noEmit -p apps/desktop/tsconfig.node.json && tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/pi-runtime-adapter/tsconfig.json",
    "lint": "pnpm lint:eslint && pnpm lint:boundary",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:boundary": "node tools/check-renderer-boundary.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "smoke": "pnpm --filter @deepwrite/desktop smoke",
    "smoke:conversation": "node apps/desktop/scripts/electron-conversation-smoke.mjs",
    "smoke:shutdown": "node apps/desktop/scripts/electron-shutdown-smoke.mjs",
    "smoke:renderer": "node tools/check-renderer-build.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "pack:test": "node tools/run-test-package.mjs all",
    "pack:test:win": "node tools/run-test-package.mjs win x64",
    "pack:test:linux": "node tools/run-test-package.mjs linux x64",
    "pack:test:mac:arm64": "node tools/run-test-package.mjs mac arm64",
    "pack:test:mac:x64": "node tools/run-test-package.mjs mac x64",
    "pack:test:mac": "node tools/run-test-package.mjs mac all"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "electron": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
